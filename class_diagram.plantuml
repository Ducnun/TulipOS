@startuml ESPBASIC

' Interfaces and base types
interface IOInterface {
    + print(const string&): void
    + readLine(): string
    + clearScreen(): void
    + setCursor(): void
}

enum TokenType {
    Number
    String
    Identifier
    Keyword
    Symbol
    EndOfLine
    Unknown
}

enum ValueType {
    Integer
    String
    Boolean
    Float
    None
}

class Token {
    + TokenType type
    + string value
    + toString(): string
}

struct VariableValue {
    + ValueType type
    + uint16_t intValue
    + string stringValue
    + bool boolValue
    + float floatValue

    + VariableValue()
    + fromInt(uint16_t): VariableValue
    + fromString(string): VariableValue
    + fromBool(bool): VariableValue
    + fromFloat(float): VariableValue
    + toString(): string
}

' Main interpreter
class Interpreter {
    + Interpreter(IOInterface& io)
    + runREPL(): void
    - IOInterface& io
    - map<int, vector<Token>> _programLines
    - unordered_map<string, VariableValue> _variables

    - preprocess(const string&): string
    - storeProgramLine(const string&): void
    - evaluateImmediateCommand(const string&): void
    - runProgram(): void
    - listProgram(): void
    - clearProgram(): void
}

class ExpressionEvaluator {
    + ExpressionEvaluator(const unordered_map<string, VariableValue>&)
    + evaluate(const vector<Token>&): string

    - unordered_map<string, VariableValue> _variables
    - toRPN(const vector<Token>&): vector<Token>
    - evaluateRPN(const vector<Token>&): VariableValue
    - precedence(const string&): int
    - isOperator(const Token&): bool
}

class Parser {
    + Parser(vector<Token>, IOInterface&, unordered_map<string, VariableValue>&)
    + parse(): void

    - vector<Token> _tokens
    - IOInterface& _io
    - unordered_map<string, VariableValue>& _variables
}

class Tokenizer {
    + tokenize(const string&): vector<Token>
}

class ConsoleIO {
    + print(const string&): void
    + readLine(): string
    + clearScreen(): void
    + setCursor(): void
}

' Inheritance
ConsoleIO ..|> IOInterface

' Dependencies
Interpreter --> IOInterface
Interpreter --> Token
Interpreter --> VariableValue

Parser --> Token
Parser --> IOInterface
Parser --> VariableValue

ExpressionEvaluator --> Token
ExpressionEvaluator --> VariableValue

Tokenizer --> Token

@enduml
